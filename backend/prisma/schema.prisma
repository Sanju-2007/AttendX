generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             String          @id @default(uuid())
  email          String          @unique
  passwordHash   String
  role           Role
  firstName      String
  lastName       String
  profilePic     String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  adminProfile   AdminProfile?
  faceEmbedding  FaceEmbedding?
  studentProfile StudentProfile?
  teacherProfile TeacherProfile?
}

model AdminProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])
}

model TeacherProfile {
  id             String      @id @default(uuid())
  userId         String      @unique
  departmentId   String?
  isApproved     Boolean     @default(false)
  faceRegistered Boolean     @default(false)
  department     Department? @relation(fields: [departmentId], references: [id])
  user           User        @relation(fields: [userId], references: [id])
  timetables     Timetable[]
}

model StudentProfile {
  id                 String           @id @default(uuid())
  userId             String           @unique
  rollNumber         String           @unique
  departmentId       String?
  sectionId          String?
  year               Int
  faceRegistered     Boolean          @default(false)
  allowSectionChange Boolean          @default(false)
  attendances        Attendance[]
  registrations  QRRegistration[]
  department     Department?      @relation(fields: [departmentId], references: [id])
  section        Section?         @relation(fields: [sectionId], references: [id])
  user           User             @relation(fields: [userId], references: [id])
}

model Department {
  id        String           @id @default(uuid())
  name      String           @unique
  code      String           @unique
  createdAt DateTime         @default(now())
  students  StudentProfile[]
  subjects  Subject[]
  teachers  TeacherProfile[]
}

model Subject {
  id           String      @id @default(uuid())
  name         String
  code         String      @unique
  departmentId String
  department   Department  @relation(fields: [departmentId], references: [id])
  timetables   Timetable[]
}

model Section {
  id         String           @id @default(uuid())
  name       String
  year       Int
  students   StudentProfile[]
  timetables Timetable[]
}

model Timetable {
  id            String           @id @default(uuid())
  dayOfWeek     Int
  startTime     String
  endTime       String
  teacherId     String
  subjectId     String
  sectionId     String
  attendances   Attendance[]
  registrations QRRegistration[]
  section       Section          @relation(fields: [sectionId], references: [id])
  subject       Subject          @relation(fields: [subjectId], references: [id])
  teacher       TeacherProfile   @relation(fields: [teacherId], references: [id])
}

model FaceEmbedding {
  id        String   @id @default(uuid())
  userId    String   @unique
  embedding Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

model TeacherInviteToken {
  id        String   @id @default(uuid())
  token     String   @unique
  used      Boolean  @default(false)
  createdBy String
  createdAt DateTime @default(now())
}

model Attendance {
  id          String           @id @default(uuid())
  studentId   String
  timetableId String
  date        DateTime
  status      AttendanceStatus
  confidence  Float?
  isManual    Boolean          @default(false)
  remarks     String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  student     StudentProfile   @relation(fields: [studentId], references: [id])
  timetable   Timetable        @relation(fields: [timetableId], references: [id])

  @@unique([studentId, timetableId, date])
}

model QRRegistration {
  id          String         @id @default(uuid())
  token       String         @unique
  expiresAt   DateTime
  timetableId String
  studentId   String
  used        Boolean        @default(false)
  createdAt   DateTime       @default(now())
  student     StudentProfile @relation(fields: [studentId], references: [id])
  timetable   Timetable      @relation(fields: [timetableId], references: [id])
}

model OtpVerification {
  id        String   @id @default(uuid())
  email     String
  otp       String
  type      OtpType  @default(REGISTRATION)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email, type])
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  CANCELLED
  HOLIDAY
}

enum OtpType {
  REGISTRATION
  PASSWORD_RESET
  LOGIN_2FA
}

